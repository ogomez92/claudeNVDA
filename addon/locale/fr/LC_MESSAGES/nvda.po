msgid "Low (fastest)"
msgstr "Faible (le plus rapide)"

#. Translators: Reasoning effort level
msgid "Medium"
msgstr "Moyen"

#. Translators: Reasoning effort level
msgid "High"
msgstr "Élevé"

#. Translators: Reasoning effort level
msgid "Extra high"
msgstr "Très élevé"

#. Translators: Reasoning effort level
msgid "Maximum (slowest)"
msgstr "Maximal (le plus lent)"

#. Translators: Label for model selection dropdown
msgid "M&odel:"
msgstr "M&odèle:"

