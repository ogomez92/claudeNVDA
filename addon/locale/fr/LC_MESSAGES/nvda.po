msgstr "Conversation effacée"

#. Translators: Message when response is copied
msgid "Response copied to clipboard"
msgstr "Réponse copiée dans le presse-papiers"

#. Translators: Message when there's no response to copy
msgid "No response to copy"
msgstr "Aucune réponse à copier"

#. Translators: Reported when computer use fails unexpectedly
#, python-brace-format
msgid "Something went wrong: {error}"
msgstr "Une erreur s'est produite: {error}"

#. Translators: Announced when a computer use task is paused
msgid "Paused. Type any new guidance for Claude in the dialog, then press Resume to continue."
msgstr "En pause. Saisissez de nouvelles instructions pour Claude dans le dialogue, puis appuyez sur Reprendre pour continuer."

#. Translators: Announced when a computer use task is complete
msgid "Finished. Type a follow-up request and press Continue, or press New task to start over."
msgstr "Terminé. Saisissez une demande de suivi et appuyez sur Continuer, ou appuyez sur Nouvelle tâche pour recommencer."

#. Translators: Announced when a computer use session ends
msgid "Finished."
msgstr "Terminé."

#. Translators: Announced when computer use starts working
msgid "Working…"
msgstr "En cours…"

#. Translators: Announced when the user stops a computer use task
msgid "Stopped."
msgstr "Arrêté."

#. Translators: Reported when a computer use request fails; the task can be resumed
#, python-brace-format
msgid "Claude API error: {error}"
msgstr "Erreur de l'API Claude: {error}"

msgid "Claude's reply was cut off. Raise the maximum tokens per step in the Claude AI settings, or press Resume to let it try again."
msgstr "La réponse de Claude a été tronquée. Augmentez le nombre maximal de tokens par étape dans les paramètres de Claude AI, ou appuyez sur Reprendre pour qu'il réessaie."

#. Translators: Reported when a computer use task reaches its step limit
msgid "Reached the maximum number of steps."
msgstr "Nombre maximal d'étapes atteint."

#. Translators: Reported when an action Claude asked for could not run
#, python-brace-format
msgid "Action failed: {error}"
msgstr "Échec de l'action: {error}"

#. Translators: Activity log entry: Claude took a screenshot
msgid "Taking a screenshot"
msgstr "Capture d'écran"

#. Translators: Activity log entry: Claude zoomed into part of the screen
msgid "Zooming in to read detail"
msgstr "Zoom pour lire les détails"

#. Translators: Activity log entry: Claude waited
msgid "Waiting"
msgstr "Attente"

#. Translators: Activity log entry: Claude checked the pointer position
msgid "Checking the pointer position"
msgstr "Vérification de la position du pointeur"

#. Translators: Activity log entry: Claude typed text. {text} is the text
#, python-brace-format
msgid "Typing: {text}"
msgstr "Saisie: {text}"

#. Translators: Activity log entry: Claude pressed keys. {keys} is the key combination
#, python-brace-format
msgid "Pressing {keys}"
msgstr "Appui sur {keys}"

#. Translators: Activity log entry: Claude held keys. {keys} is the key combination
#, python-brace-format
msgid "Holding {keys}"
msgstr "Maintien de {keys}"

#. Translators: Scroll direction, used in "Scrolling {direction}"
msgid "up"
msgstr "vers le haut"

#. Translators: Scroll direction, used in "Scrolling {direction}"
msgid "down"
msgstr "vers le bas"

#. Translators: Scroll direction, used in "Scrolling {direction}"
msgid "left"
msgstr "vers la gauche"

#. Translators: Scroll direction, used in "Scrolling {direction}"
msgid "right"
msgstr "vers la droite"

#. Translators: Activity log entry: Claude scrolled. {direction} is up, down, left or right
#, python-brace-format
msgid "Scrolling {direction}"
msgstr "Défilement {direction}"

#. Translators: Activity log entry: Claude clicked. {x} and {y} are coordinates
#, python-brace-format
msgid "Clicking at {x}, {y}"
msgstr "Clic en {x}, {y}"

#. Translators: Activity log entry: Claude clicked where the pointer already was
msgid "Clicking"
msgstr "Clic"

#. Translators: Activity log entry: Claude right-clicked
msgid "Right-clicking"
msgstr "Clic droit"

#. Translators: Activity log entry: Claude middle-clicked
msgid "Middle-clicking"
msgstr "Clic du milieu"

#. Translators: Activity log entry: Claude moved the pointer. {x} and {y} are coordinates
#, python-brace-format
msgid "Moving the pointer to {x}, {y}"
msgstr "Déplacement du pointeur en {x}, {y}"

#. Translators: Activity log entry: Claude dragged with the mouse
msgid "Dragging"
msgstr "Glisser-déposer"

#. Translators: Activity log entry for any other action. {action} is its name
#, python-brace-format
msgid "Performing action: {action}"
msgstr "Exécution de l'action: {action}"

#. Translators: Title of the computer use dialog
#. Translators: Title of a computer use message box
msgid "Claude Computer Use"
msgstr "Utilisation de l'ordinateur par Claude"

msgid "&What would you like Claude to do?"
msgstr "&Que voulez-vous que Claude fasse?"

msgid "Examples. Assistant: \"I'm stuck on this website, please tick the 'I agree' checkbox and press Continue.\" Screen-reader testing: \"Tab through this form and tell me whether every field is announced with a label.\""
msgstr "Exemples. Assistant: « Je suis bloqué sur ce site web, veuillez cocher la case “J'accepte” et appuyer sur Continuer. » Test de lecteur d'écran: « Parcourez ce formulaire avec Tab et dites-moi si chaque champ est annoncé avec une étiquette. »"

#. Translators: Label for the computer use mode selector
msgid "&Mode"
msgstr "&Mode"

#. Translators: The computer use assistant mode
msgid "Assistant: do a task on my screen"
msgstr "Assistant: effectuer une tâche sur mon écran"

#. Translators: The computer use screen-reader testing mode
msgid "Screen-reader testing: check accessibility with NVDA's speech"
msgstr "Test de lecteur d'écran: vérifier l'accessibilité avec la parole de NVDA"

msgid "&Activity"
msgstr "&Activité"

#. Translators: Button that starts a computer use task
msgid "&Start"
msgstr "&Démarrer"

#. Translators: Button that stops a running computer use task
msgid "Sto&p"
msgstr "Arrê&ter"

#. Translators: Button that discards a finished computer use conversation
msgid "&New task"
msgstr "&Nouvelle tâche"

#. Translators: Button that closes the computer use dialog
msgid "&Close"
msgstr "&Fermer"

#. Translators: Announced when the computer use request is empty
msgid "Please type what you would like Claude to do."
msgstr "Veuillez saisir ce que vous voulez que Claude fasse."

#. Translators: Activity log line when a computer use task starts
msgid "Starting."
msgstr "Démarrage."

#. Translators: Activity log line when a paused computer use task resumes
msgid "Resuming."
msgstr "Reprise."

#. Translators: Activity log line when a follow-up computer use request starts
msgid "Continuing."
msgstr "Poursuite de la tâche."

#. Translators: Announced when a finished computer use conversation is discarded
msgid "New task. The previous conversation was discarded."
msgstr "Nouvelle tâche. La conversation précédente a été supprimée."

#. Translators: Activity log line when the user stops a computer use task
msgid "Stopping."
msgstr "Arrêt."

#. Translators: Confirmation when closing the dialog while a computer use task runs
msgid "A task is still running. Stop it and close?"
msgstr "Une tâche est encore en cours. L'arrêter et fermer?"

#. Translators: Activity log prefix for an action Claude performed
msgid "Action"
msgstr "Action"

#. Translators: Activity log prefix for a status update
msgid "Status"
msgstr "État"

#. Translators: Activity log prefix for an error
msgid "Error"
msgstr "Erreur"

#. Translators: Button that resumes a paused computer use task
msgid "&Resume"
msgstr "&Reprendre"

#. Translators: Button that sends a follow-up once a computer use task finished
msgid "C&ontinue"
msgstr "C&ontinuer"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
msgid "ClauVDA (Anthropic Claude AI NVDA)"
msgstr "ClauVDA (Anthropic Claude AI NVDA)"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
msgid ""
"Comprehensive Anthropic Claude AI capabilities integrated into NVDA.\n"
"Supports Claude Haiku 5.5, Sonnet 5.5, Opus 5.5, and Fable 5.1 for chat, image description, and more."
msgstr ""
"Les fonctionnalités complètes de l'IA Claude d'Anthropic intégrées à NVDA.\n"
"Prend en charge Claude Haiku 5.5, Sonnet 5.5, Opus 5.5 et Fable 5.1 pour le chat, la description d'images et plus encore."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
msgid "Updated to the latest Claude models with Haiku 5.5 as the default. Adds computer use, PDF summaries and OCR, web search, and reasoning effort settings."
msgstr "Mise à jour vers les derniers modèles Claude, avec Haiku 5.5 par défaut. Ajoute l'utilisation de l'ordinateur, les résumés et l'OCR de PDF, la recherche web et les réglages d'effort de raisonnement."
