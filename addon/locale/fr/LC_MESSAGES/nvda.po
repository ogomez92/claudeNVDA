#. Translators: Title of Bedrock key configuration dialog
msgid "Amazon Bedrock API Key"
msgstr "Clé API Amazon Bedrock"

#. Translators: Title of Anthropic key configuration dialog
msgid "Anthropic API Key"
msgstr "Clé API Anthropic"

msgid ""
"Enter your Amazon Bedrock API key (bearer token).\n"
"Create one at: https://console.aws.amazon.com/bedrock/home#/api-keys"
msgstr ""
"Saisissez votre clé API Amazon Bedrock (jeton bearer).\n"
"Créez-en une sur: https://console.aws.amazon.com/bedrock/home#/api-keys"

msgid ""
"Enter your Anthropic API key.\n"
"Get one at: https://console.anthropic.com/settings/keys"
msgstr ""
"Saisissez votre clé API Anthropic.\n"
"Obtenez-en une sur: https://console.anthropic.com/settings/keys"

#, python-brace-format
msgid "Current key source: {source}"
msgstr "Source actuelle de la clé: {source}"

#. Translators: Label for API key input field
msgid "API &Key:"
msgstr "&Clé API:"

#. Translators: Button to delete saved API key
msgid "&Delete Key"
msgstr "&Supprimer la clé"

#. Translators: Confirmation that API key was saved
msgid "API key saved"
msgstr "Clé API enregistrée"

#. Translators: Error saving API key
msgid "Failed to save API key"
msgstr "Échec de l'enregistrement de la clé API"

#. Translators: Confirmation that API key was deleted
msgid "API key deleted"
msgstr "Clé API supprimée"

#. Translators: Error deleting API key
msgid "Failed to delete API key"
msgstr "Échec de la suppression de la clé API"

#. Translators: Title of settings panel
#. Translators: Category for input gestures
#. Translators: Title of the main Claude dialog
msgid "Claude AI"
msgstr "Claude AI"

msgid "&API provider:"
msgstr "Fournisseur d'&API:"

msgid "Anthropic (direct)"
msgstr "Anthropic (direct)"

msgid "Amazon Bedrock"
msgstr "Amazon Bedrock"

msgid "AWS &region (Bedrock only):"
msgstr "Ré&gion AWS (Bedrock uniquement):"

msgid "Configure &Anthropic API Key..."
msgstr "Configurer la clé API &Anthropic..."

msgid "Configure &Bedrock API Key..."
msgstr "Configurer la clé API &Bedrock..."

msgid "Default &model:"
msgstr "&Modèle par défaut:"

msgid "Bedrock model IDs"
msgstr "Identifiants des modèles Bedrock"

#. Translators: Label for the Bedrock ID of a specific model.
#. {name} is the human-readable model name.
#, python-brace-format
msgid "{name}:"
msgstr "{name}:"

msgid "Ma&x output tokens:"
msgstr "Tokens de sortie ma&x:"

msgid "Reasoning &effort for chat:"
msgstr "&Effort de raisonnement pour le chat:"

