msgid "High"
msgstr "Alto"

#. Translators: Reasoning effort level
msgid "Extra high"
msgstr "Muito alto"

#. Translators: Reasoning effort level
msgid "Maximum (slowest)"
msgstr "Máximo (mais lento)"

