msgstr "&Lembrar prompt do sistema"

msgid "&Block Escape key in dialog"
msgstr "&Bloquear tecla Escape no diálogo"

msgid "&Filter markdown from responses"
msgstr "&Filtrar markdown das respostas"

#. Video analysis prompt
#. Translators: Label for video analysis prompt text field
msgid "&Video analysis prompt:"
msgstr "Prompt de análise de &vídeo:"

#. Translators: Default video analysis prompt sent to the AI model
msgid "Describe this video in detail, but concise. Get as much information as you can and if there is any important text in the video read it."
msgstr "Descreva este vídeo em detalhe, mas de forma concisa. Obtenha o máximo de informação possível e se houver algum texto importante no vídeo, leia-o."

#. Summarize selection prompt
#. Translators: Label for summarize selection prompt text field
msgid "S&ummarize selection prompt:"
msgstr "Prompt de res&umo de seleção:"

#. Translators: Default prompt used when summarizing selected text with AI
msgid "Summarize the key points of the following text in a clear and concise manner:"
msgstr "Resuma os pontos principais do texto a seguir de forma clara e concisa:"

#. Summarize last speech prompt
#. Translators: Label for summarize last speech prompt text field
msgid "Summarize last s&peech prompt:"
msgstr "Prompt de resum&o da última fala:"

#. Translators: Default prompt used when summarizing the last spoken text with AI
msgid "Summarize the following text concisely. Respond in the same language as the text:"
msgstr "Resuma o texto a seguir de forma concisa. Responda no mesmo idioma do texto:"

msgid "Sound Feedback"
msgstr "Feedback sonoro"

msgid "Play sound when request &sent"
msgstr "Tocar som ao &enviar solicitação"

msgid "Play sound while &waiting"
msgstr "Tocar som enquanto &aguarda"

msgid "Play sound when response &received"
msgstr "Tocar som ao &receber resposta"

#. Translators: Group label for computer use settings
msgid "Computer use"
msgstr "Uso do computador"

msgid "Computer use mo&del:"
msgstr "Mo&delo do uso do computador:"

msgid "Computer use reasoning effor&t:"
msgstr "Esforço de raciocí&nio do uso do computador:"

#. Translators: Label for the number of Claude turns before a computer use task pauses
msgid "Maximum steps per tas&k:"
msgstr "Máximo de pa&ssos por tarefa:"

#. Translators: Label for the output token limit of each computer use turn
msgid "Maximum tokens per step:"
msgstr "Máximo de tokens por passo:"

#. Translators: Label for the size of the screenshots Claude sees
msgid "Screenshot longest edge (pixels):"
msgstr "Lado maior da captura de tela (pixels):"

#. Translators: Label for the pause after each action before the next screenshot
msgid "Delay after each action (milliseconds):"
msgstr "Atraso após cada ação (milissegundos):"

#. Translators: Label for the extra wait used to capture NVDA's speech in testing mode
msgid "Speech capture delay in testing mode (milliseconds):"
msgstr "Atraso de captura da fala no modo de teste (milissegundos):"

#. Translators: Label for how many recent actions keep their results in context
msgid "Recent actions to keep in context:"
msgstr "Ações recentes a manter no contexto:"

msgid "Allow Claude to &zoom in for detail"
msgstr "Permitir que o Claude dê &zoom para ver detalhes"

#. Translators: Menu item to open Claude dialog
msgid "Open Claude &Dialog...\tNVDA+G"
msgstr "Abrir &diálogo do Claude...\tNVDA+G"

#. Translators: Menu item to open the computer use dialog
msgid "Computer &use...\tNVDA+Alt+Shift+C"
msgstr "&Uso do computador...\tNVDA+Alt+Shift+C"

#. Translators: Menu item to summarize a PDF
msgid "Summari&ze PDF...\tNVDA+Shift+P"
msgstr "Resu&mir PDF...\tNVDA+Shift+P"

#. Translators: Menu item to read all the text of a PDF with AI
msgid "&Read PDF text with AI (OCR)...\tNVDA+Alt+P"
msgstr "&Ler texto de PDF com IA (OCR)...\tNVDA+Alt+P"

#. Translators: Menu item to open settings
msgid "&Settings..."
msgstr "&Configurações..."

#. Translators: Menu item to open API key page for active provider
msgid "Get &API Key (web)..."
msgstr "Obter chave &API (web)..."

msgid "&Claude"
msgstr "&Claude"

msgid "Anthropic SDK failed to load. Please reinstall the add-on."
msgstr "Falha ao carregar o SDK da Anthropic. Reinstale o complemento."

#. Translators: Description for show dialog script
msgid "Show Claude AI dialog"
msgstr "Mostra o diálogo do Claude AI"

#. Translators: Description for describe screen script
msgid "Describe the entire screen using Claude"
msgstr "Descreve a tela inteira usando o Claude"

msgid "Anthropic SDK not installed."
msgstr "SDK da Anthropic não instalado."

#. Translators: Message while capturing screenshot
msgid "Capturing screen..."
msgstr "Capturando tela..."

#. Translators: Error when screenshot fails
msgid "Failed to capture screenshot"
msgstr "Falha ao capturar tela"

#. Translators: Description for describe object script
msgid "Describe the navigator object using Claude"
msgstr "Descreve o objeto de navegação usando o Claude"

#. Translators: Message while capturing object
msgid "Capturing object..."
msgstr "Capturando objeto..."

#. Translators: Error when object capture fails
msgid "Failed to capture object"
msgstr "Falha ao capturar objeto"

#. Translators: Message while extracting frames from the video
msgid "Extracting frames..."
msgstr "Extraindo quadros..."

#. Translators: Error when frame extraction fails
msgid "Failed to extract frames from video"
msgstr "Falha ao extrair quadros do vídeo"

#. Translators: Message while analyzing video
msgid "Analyzing video..."
msgstr "Analisando vídeo..."

#, python-brace-format
msgid "The following images are {count} frames sampled in order from a short screen recording."
msgstr "As imagens a seguir são {count} quadros extraídos, em ordem, de uma curta gravação de tela."

#, python-brace-format
msgid "Video analysis failed: {error}"
msgstr "Análise de vídeo falhou: {error}"

#. Translators: Description for video capture toggle script
msgid "Start or stop video recording for Claude analysis"
msgstr "Inicia ou para a gravação de vídeo para análise pelo Claude"

#. Translators: Error when video capture dependencies not available
msgid "Video capture not available. Missing dependencies."
msgstr "Captura de vídeo não disponível. Dependências faltando."

#. Stop recording
#. Translators: Message when stopping video recording
msgid "Stopping recording..."
msgstr "Parando gravação..."

#. Translators: Message when video saved successfully
msgid "Video saved. Sending to Claude for analysis..."
msgstr "Vídeo salvo. Enviando ao Claude para análise..."

#. Translators: Error when video save fails
msgid "Failed to save video"
msgstr "Falha ao salvar vídeo"

#. Translators: Message when video recording starts
msgid "Recording started. Press NVDA+V again to stop."
msgstr "Gravação iniciada. Pressione NVDA+V novamente para parar."

#. Translators: Error when video recording fails to start
msgid "Failed to start recording"
msgstr "Falha ao iniciar gravação"

#. Translators: Computer use is not offered for the Bedrock provider
msgid "Computer use needs the Anthropic API provider. Change it in the Claude AI settings."
msgstr "O uso do computador requer a API da Anthropic como provedor. Altere isso nas configurações do Claude AI."

#. Translators: Computer use relies on APIs added in NVDA 2026.1
msgid "Computer use needs NVDA 2026.1 or later."
msgstr "O uso do computador requer o NVDA 2026.1 ou posterior."

#. Translators: Description of the command that opens the computer use dialog
msgid "Open Claude computer use, to let Claude operate the current window"
msgstr "Abre o uso do computador do Claude, para que o Claude opere a janela atual"

#. Translators: Description of the command that pauses a running computer use task
msgid "Pause the running computer use task and open its dialog to guide Claude"
msgstr "Pausa a tarefa de uso do computador em execução e abre seu diálogo para orientar o Claude"

#. Translators: Announced when the user pauses a computer use task
msgid "Pausing the Claude task…"
msgstr "Pausando a tarefa do Claude…"

#. Translators: Announced when the computer use task is already paused
msgid "The Claude task is paused. Type guidance in the dialog, then resume."
msgstr "A tarefa do Claude está pausada. Digite orientações no diálogo e depois retome."

#. Translators: Announced when no computer use task is running
msgid "No Claude task is running."
msgstr "Nenhuma tarefa do Claude em execução."

#. Translators: Description of the command that summarizes a PDF
msgid "Summarize a PDF: the one selected in File Explorer, or one you choose"
msgstr "Resume um PDF: o selecionado no Explorador de Arquivos ou outro que você escolher"

msgid "Read all the text of a PDF with AI (OCR), including scanned pages: the one selected in File Explorer, or one you choose"
msgstr "Lê todo o texto de um PDF com IA (OCR), incluindo páginas digitalizadas: o selecionado no Explorador de Arquivos ou outro que você escolher"

#. Translators: Title of PDF file selection dialog
msgid "Select PDF"
msgstr "Selecionar PDF"

#. Translators: File type filter in the PDF selection dialog
msgid "PDF documents (*.pdf)|*.pdf"
msgstr "Documentos PDF (*.pdf)|*.pdf"

#. Translators: Announced while Claude summarizes a PDF. {name} is the file name
#, python-brace-format
msgid "Summarizing {name}..."
msgstr "Resumindo {name}..."

msgid "Summarize this PDF. Start with one sentence saying what kind of document it is, then give its key points. Write the summary in the language of this request."
msgstr "Resuma este PDF. Comece com uma frase dizendo que tipo de documento é e depois apresente seus pontos principais. Escreva o resumo no idioma desta solicitação."

#. Translators: Title of the window showing a PDF summary. {name} is the file name
#, python-brace-format
msgid "Summary of {name}"
msgstr "Resumo de {name}"

#. Translators: Announced while Claude reads the text of a PDF. {name} is the file name
#, python-brace-format
msgid "Reading the text of {name}. Long documents can take a while."
msgstr "Lendo o texto de {name}. Documentos longos podem demorar um pouco."

#. Translators: Title of the window showing the text read from a PDF. {name} is the file name
#, python-brace-format
msgid "Text of {name}"
msgstr "Texto de {name}"

#. Translators: Error when a PDF can't be read from disk
#, python-brace-format
msgid "Could not read {name}"
msgstr "Não foi possível ler {name}"

#. Translators: Added to a PDF result that hit the output limit
msgid "[The result was cut off because it reached the output limit.]"
msgstr "[O resultado foi cortado porque atingiu o limite de saída.]"

#. Translators: Error while summarizing or reading a PDF
#, python-brace-format
msgid "PDF request failed: {error}"
msgstr "Falha na solicitação do PDF: {error}"

#. Translators: Description for summarize selection script
msgid "Summarize selected text using Claude"
msgstr "Resume o texto selecionado usando o Claude"

#. Translators: Error when no text is selected for summarization
msgid "No text selected"
msgstr "Nenhum texto selecionado"

#. Translators: Message while summarizing text
#. Translators: Message while summarizing last speech
msgid "Summarizing..."
msgstr "Resumindo..."

#. Translators: Description for summarize last speech script
msgid "Summarize the last spoken text using Claude"
msgstr "Resume o último texto falado usando o Claude"

#. Translators: Error when no speech history is available
msgid "No speech history available"
msgstr "Nenhum histórico de fala disponível"

#, python-brace-format
msgid "Summarization failed: {error}"
msgstr "Falha ao resumir: {error}"

#. Translators: Error when a PDF is too large to send. {name} is the file name
#, python-brace-format
msgid "{name} is too large to send. PDFs can be up to 20 MB."
msgstr "{name} é grande demais para enviar. Os PDFs podem ter até 20 MB."

#. Translators: Spoken when Claude's safety checks decline a request
msgid "Claude declined this request. Try rephrasing it, or choose a different model."
msgstr "O Claude recusou esta solicitação. Tente reformulá-la ou escolha outro modelo."

msgid "No response from AI"
msgstr "Sem resposta da IA"

#. Translators: Heading above the web pages Claude cited in a reply
msgid "Sources:"
