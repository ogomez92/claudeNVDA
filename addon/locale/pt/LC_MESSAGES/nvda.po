#. Translators: Title of Bedrock key configuration dialog
msgid "Amazon Bedrock API Key"
msgstr "Chave API do Amazon Bedrock"

#. Translators: Title of Anthropic key configuration dialog
msgid "Anthropic API Key"
msgstr "Chave API da Anthropic"

msgid ""
"Enter your Amazon Bedrock API key (bearer token).\n"
"Create one at: https://console.aws.amazon.com/bedrock/home#/api-keys"
msgstr ""
"Digite sua chave API do Amazon Bedrock (token de portador).\n"
"Crie uma em: https://console.aws.amazon.com/bedrock/home#/api-keys"

msgid ""
"Enter your Anthropic API key.\n"
"Get one at: https://console.anthropic.com/settings/keys"
msgstr ""
"Digite sua chave API da Anthropic.\n"
"Obtenha uma em: https://console.anthropic.com/settings/keys"

#, python-brace-format
msgid "Current key source: {source}"
msgstr "Fonte da chave atual: {source}"

#. Translators: Label for API key input field
msgid "API &Key:"
msgstr "&Chave API:"

#. Translators: Button to delete saved API key
msgid "&Delete Key"
msgstr "&Excluir chave"

#. Translators: Confirmation that API key was saved
msgid "API key saved"
msgstr "Chave API salva"

#. Translators: Error saving API key
msgid "Failed to save API key"
msgstr "Falha ao salvar chave API"

#. Translators: Confirmation that API key was deleted
msgid "API key deleted"
msgstr "Chave API excluída"

#. Translators: Error deleting API key
msgid "Failed to delete API key"
msgstr "Falha ao excluir chave API"

#. Translators: Title of settings panel
#. Translators: Category for input gestures
#. Translators: Title of the main Claude dialog
msgid "Claude AI"
msgstr "Claude AI"

