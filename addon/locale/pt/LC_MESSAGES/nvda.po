msgstr "Configurar chave API da &Anthropic..."

msgid "Configure &Bedrock API Key..."
msgstr "Configurar chave API do &Bedrock..."

msgid "Default &model:"
msgstr "&Modelo padrão:"

msgid "Bedrock model IDs"
msgstr "IDs de modelo do Bedrock"

