#. Translators: Title of Bedrock key configuration dialog
msgid "Amazon Bedrock API Key"
msgstr "Amazon-Bedrock-API-Schlüssel"

#. Translators: Title of Anthropic key configuration dialog
msgid "Anthropic API Key"
msgstr "Anthropic-API-Schlüssel"

msgid ""
"Enter your Amazon Bedrock API key (bearer token).\n"
"Create one at: https://console.aws.amazon.com/bedrock/home#/api-keys"
msgstr ""
"Geben Sie Ihren Amazon-Bedrock-API-Schlüssel (Bearer-Token) ein.\n"
"Erstellen Sie einen unter: https://console.aws.amazon.com/bedrock/home#/api-keys"

msgid ""
"Enter your Anthropic API key.\n"
"Get one at: https://console.anthropic.com/settings/keys"
msgstr ""
"Geben Sie Ihren Anthropic-API-Schlüssel ein.\n"
"Sie erhalten einen unter: https://console.anthropic.com/settings/keys"

#, python-brace-format
msgid "Current key source: {source}"
msgstr "Aktuelle Schlüsselquelle: {source}"

