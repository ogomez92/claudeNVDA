msgstr "&Región de AWS (solo Bedrock):"

msgid "Configure &Anthropic API Key..."
msgstr "Configurar clave API de &Anthropic..."

msgid "Configure &Bedrock API Key..."
msgstr "Configurar clave API de &Bedrock..."

msgid "Default &model:"
msgstr "&Modelo predeterminado:"

